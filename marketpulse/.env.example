# ======================================================================
# MarketPulse — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel.
# NUNCA exponha estas chaves no frontend (apenas NEXT_PUBLIC_* é público).
# ======================================================================

# --- Acesso (app pessoal: 1 usuário) -----------------------------------
# Senha de acesso ao app (mínimo 12 caracteres recomendado)
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (>= 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Segredo exigido pelo endpoint /api/cron/tick (Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- Armazenamento persistente (Upstash Redis via Vercel Marketplace) ---
# Aceita UPSTASH_REDIS_REST_URL/TOKEN ou KV_REST_API_URL/TOKEN (Vercel integra automaticamente).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sem Redis o app roda com armazenamento em memória (SÓ para desenvolvimento local).

# --- Cotações (Twelve Data: https://twelvedata.com — plano gratuito 800 créditos/dia, 8/min)
TWELVEDATA_API_KEY=
# Orçamento de créditos por minuto que o app se permite usar (<= limite do plano)
MARKET_CREDITS_PER_MINUTE=8

# --- Calendário econômico ------------------------------------------------
# forexfactory (padrão, gratuito, semana atual + próxima, sem chave)
# tradingeconomics (pago para EUA; chave "cliente:senha")
# fmp (Financial Modeling Prep; verifique se o seu plano inclui economic-calendar)
CALENDAR_PROVIDER=forexfactory
TRADINGECONOMICS_API_KEY=
FMP_API_KEY=

# --- Juros americanos / dólar (opcional, FRED — gratuito, dado diário) -----
FRED_API_KEY=

# --- Notícias (RSS, separados por vírgula: "Nome|URL,Nome|URL") -----------
# Deixe vazio para usar os feeds padrão (Fed, BLS, FXStreet, ForexLive, CNBC, Investing.com)
NEWS_FEEDS=

# --- Inteligência artificial (Anthropic) ---------------------------------
ANTHROPIC_API_KEY=
# Modelo padrão: claude-opus-5-5. Para reduzir custo: claude-sonnet-5-5
AI_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high
AI_EFFORT=medium

# --- Web Push (gere com: npm run vapid) -----------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# --- App -------------------------------------------------------------------
# URL pública (usada nos links das notificações)
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Fuso horário de exibição
APP_TIMEZONE=America/Sao_Paulo

# --- Somente para testes locais (apontar provedores para um mock) ---------
# TWELVEDATA_BASE_URL=http://localhost:3199/td
# FF_CALENDAR_URLS=http://localhost:3199/ff.json
# FRED_BASE_URL=http://localhost:3199
# ANTHROPIC_BASE_URL=http://localhost:3199/anthropic
